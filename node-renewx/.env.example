NODE_ENV=production
HOST=0.0.0.0
# Native Node listens on PORT. Docker maps WEB_PORT on the host to PORT in the container.
PORT=3000
WEB_PORT=3000
DATA_DIR=/data

# Required. This is the web administrator password. Do not commit it.
ADMIN_PASSWORD=change-this-password
# Required in production. Any stable secret is accepted and is hashed to a 32-byte AES key.
DATA_ENCRYPTION_KEY=change-this-encryption-key

# Used by the Microsoft OAuth authorization-code flow.
PUBLIC_BASE_URL=http://localhost:3000
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Optional pause notifications. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SECURE=false

COOKIE_SECURE=false
TRUST_PROXY=false

# Scheduler and request safety defaults.
SCHEDULER_POLL_MS=15000
MIN_DELAY_MS=3000
MAX_REQUESTS_PER_RUN=6
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
ALLOW_WRITE_ACTIVITY=false
