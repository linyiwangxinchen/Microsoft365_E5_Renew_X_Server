{
  "name": "microsoft365-e5-renewx-web",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Microsoft Graph activity runner with a web UI for Microsoft 365 developer tenants.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^7.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
